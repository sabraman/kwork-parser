# Required. Keep the real values private.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ADMIN_ID=123456789
KWORK_LOGIN=replace_me
KWORK_PASSWORD=replace_me

# Polling intervals.
MESSAGE_CHECK_INTERVAL=3
MESSAGE_CHECK_MIN=1
MESSAGE_CHECK_MAX=10
STATS_CHECK_INTERVAL=60
ORDERS_CHECK_INTERVAL=5
SUMMARY_INTERVAL_HOURS=6

# Optional quiet window in the service's local timezone.
QUIET_HOURS=22-8
QUIET_ALLOW_INBOX=true

# Use absolute paths under /var/lib/kwork-parser on a VPS.
STATE_PATH=kwork-state.json
KWORK_TOKEN_PATH=.kwork-token.json
RUST_LOG=info
